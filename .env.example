# Environment Configuration for Agentic RAG AI SRE Platform

# App & Server Settings
APP_NAME=Agentic-RAG-SRE
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-super-secret-key-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite for instant zero-dependency execution; in production use postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./sre_platform.db
# Read-only database connection for safe Text2SQL execution
DATABASE_READONLY_URL=sqlite+aiosqlite:///./sre_platform.db

# Vector Store (Qdrant)
# Leave QDRANT_URL empty to use in-memory/local disk Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sre_operational_knowledge

# Redis Cache
# Leave empty to use in-process thread-safe cache fallback
REDIS_URL=

# Model Providers
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Set to True to use deterministic local mock models for offline testing & demo
USE_MOCK_MODELS=True

# Security, Budgets & Limits
RATE_LIMIT_PER_MINUTE=20
TOKEN_BUDGET_PER_DAY=100000
MAX_INPUT_TOKENS=4000
CRAG_RELEVANCE_THRESHOLD=0.7
SELF_RAG_FAITHFULNESS_THRESHOLD=0.8
MAX_SELF_RAG_RETRIES=2
